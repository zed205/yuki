    "express": "^4.21.0",
    "form-data": "^4.0.0",
    "markdown-pdf": "^11.0.0",
    "openai": "^6.45.0",
    "playwright": "^1.61.1",
    "turndown": "^7.2.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^1.0.1",
    "@tanstack/solid-query": "^5.107.1",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.0",
    "solid-js": "^1.9.18",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
